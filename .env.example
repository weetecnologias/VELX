# Configure runtime secrets in Sites. This file contains no usable credentials.
BOOTSTRAP_ADMIN_EMAIL=authorised-owner@example.com
# Optional email password recovery, for the future independent auth deployment.
# Configure custom SMTP and the token_hash reset template in Supabase first.
# This does not switch the current hosted sign-in away from Sites.
# AUTH_RECOVERY_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# APP_PUBLIC_URL=https://your-academy.example.com
# See docs/PASSWORD_RECOVERY.md. Never add a service-role key to browser code.
# DB and BUCKET are platform bindings, not text environment values.
# Phase 3 (not enabled; do not set until provider integration is implemented):
# PAYMENT_PROVIDER_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_PROVIDER_PUBLIC_KEY=
# PAYMENT_WEBHOOK_URL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_LANGUAGE=en
